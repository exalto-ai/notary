# Only Rust workspace inputs belong in Fly builds. SPA configuration stays local.
**
!Cargo.toml
!Cargo.lock
!runtime/
!runtime/**
!platform/
platform/**
!platform/crates/
!platform/crates/**
!platform/migrations/
!platform/migrations/**
!deploy/
deploy/**
!deploy/notary-server-entrypoint.sh
!apps/
apps/**
!apps/notary-app/
apps/notary-app/**
!apps/notary-app/src-tauri/
apps/notary-app/src-tauri/**
!apps/notary-app/src-tauri/Cargo.toml
!apps/notary-app/src-tauri/src/
apps/notary-app/src-tauri/src/**
!apps/notary-app/src-tauri/src/lib.rs

# Never upload local credentials, installed dependencies, or build outputs.
**/.env*
**/.vercel/
**/.git/
**/node_modules/
**/target/
**/.vitest-attachments/

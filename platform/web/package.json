{
  "name": "@exalto/notary-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:platform-api": "node scripts/generate-platform-api.mjs",
    "check:platform-api": "node scripts/generate-platform-api.mjs --check",
    "build": "npm run check:frontend && npm run check:platform-api && npm run check:docs && npm run test:brand && npm run build:site",
    "build:site": "npm run check:platform-types && vite build",
    "check:frontend": "biome check .",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "biome check --write .",
    "check:platform-types": "tsc -p tsconfig.platform.json",
    "test:site": "vitest run --config vitest.site.config.js",
    "test:install": "sh scripts/test-install.sh",
    "test:brand": "node scripts/test-brand.mjs",
    "test:unit": "vitest run --environment node src/notaryLifecycle.test.ts src/creditUtilization.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "dev:capture": "vite",
    "preview:capture": "EXALTO_LOCAL_PREVIEW=1 vite"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@tabler/icons-react": "^3.47.0",
    "@vitejs/plugin-react": "latest",
    "openapi-fetch": "^0.15.2",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "github-slugger": "^2.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}

:80 {
	route {
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@brand path /favicon.svg /pot-mark-white.svg /pot-mark-blue.svg /pot-tile.svg
		header @brand Cache-Control "public, max-age=0, must-revalidate"

		@art path /art/*
		header @art Cache-Control "public, max-age=86400"

		handle {
			root * /usr/share/caddy
			encode zstd gzip
			try_files {path} {path}/ /index.html
			file_server
		}
	}
}
